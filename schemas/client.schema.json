{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/grc/schemas/client.schema.json",
  "title": "Client Metadata",
  "type": "object",
  "required": ["client", "classification", "created"],
  "properties": {
    "client": {
      "type": "object",
      "required": ["name", "slug", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
        },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "CUI"]
    },
    "created": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
