{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/grc/schemas/artifact.schema.json",
  "title": "Artifact Metadata",
  "type": "object",
  "required": ["artifact_id", "artifact_type", "status", "sensitivity"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "type": "string" },
    "client": { "type": "string" },
    "framework": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirement": {
      "type": "array",
      "items": { "type": "string" }
    },
    "control": {
      "type": "array",
      "items": { "type": "string" }
    },
    "owner": { "type": "string" },
    "status": { "type": "string" },
    "sensitivity": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "CUI"]
    },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
